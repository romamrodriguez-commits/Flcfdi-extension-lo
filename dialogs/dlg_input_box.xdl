<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dlg:window PUBLIC "-//OpenOffice.org//DTD OfficeDocument 1.0//EN" "dialog.dtd" >
<dlg:window xmlns:dlg="http://openoffice.org/2000/dialog" xmlns:script="http://openoffice.org/2000/script" dlg:id="dlg_input_box" dlg:left="14" dlg:top="9" dlg:width="198" dlg:height="80" dlg:closeable="true" dlg:moveable="true">
    <dlg:styles>
        <dlg:style dlg:style-id="0" dlg:font-name="Liberation Sans" dlg:font-height="10" dlg:font-stylename="Normal" dlg:font-family="swiss" />
    </dlg:styles>
    <dlg:bulletinboard>
        <dlg:text dlg:style-id="0" dlg:id="info" dlg:tab-index="0" dlg:left="6" dlg:top="6" dlg:width="186" dlg:height="32" dlg:multiline="true" />
        <dlg:textfield dlg:style-id="0" dlg:id="value" dlg:tab-index="1" dlg:left="6" dlg:top="42" dlg:width="186" dlg:height="12" />
        <dlg:button dlg:style-id="0" dlg:id="ok" dlg:tab-index="2" dlg:left="16" dlg:top="60" dlg:width="70" dlg:height="14" dlg:tabstop="false" dlg:default="true" dlg:value="Aceptar" dlg:image-position="left-center" dlg:image-align="left" />
        <dlg:button dlg:style-id="0" dlg:id="cancel" dlg:tab-index="3" dlg:left="112" dlg:top="60" dlg:width="70" dlg:height="14" dlg:value="Cancelar" dlg:image-position="left-center" dlg:image-align="left" />
    </dlg:bulletinboard>
</dlg:window>
