 <dlg:styles>
  <dlg:style dlg:style-id="0" dlg:background-color="0x83caff" dlg:font-name="Arial" dlg:font-height="10" dlg:font-stylename="Normal" dlg:font-family="swiss" dlg:font-weight="100"/>
 </dlg:styles>
 <dlg:bulletinboard>
  <dlg:text dlg:style-id="0" dlg:id="Label1" dlg:tab-index="0" dlg:left="4" dlg:top="6" dlg:width="15" dlg:height="8" dlg:value="Mes " dlg:align="right"/>
