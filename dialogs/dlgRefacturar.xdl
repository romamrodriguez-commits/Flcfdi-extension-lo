  <dlg:button dlg:id="cmdLimpiarSeleccion" dlg:tab-index="11" dlg:visible="false" dlg:left="357" dlg:top="26" dlg:width="10" dlg:height="12" dlg:page="8" dlg:tag="Muestra la tabla de impuestos"/>
