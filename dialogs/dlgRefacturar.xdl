    <dlg:menuitem dlg:value="Abril"/>
    <dlg:menuitem dlg:value="Mayo"/>
    <dlg:menuitem dlg:value="Junio"/>
    <dlg:menuitem dlg:value="Julio"/>
    <dlg:menuitem dlg:value="Agosto"/>
    <dlg:menuitem dlg:value="Septiembre"/>
    <dlg:menuitem dlg:value="Octubre"/>
    <dlg:menuitem dlg:value="Noviembre"/>
    <dlg:menuitem dlg:value="Diciembre"/>
   </dlg:menupopup>
  </dlg:menulist>
  <dlg:text dlg:style-id="0" dlg:id="Label2" dlg:tab-index="2" dlg:left="77" dlg:top="6" dlg:width="20" dlg:height="8" dlg:value="Estatus " dlg:align="right"/>
  <dlg:text dlg:style-id="0" dlg:id="Label3" dlg:tab-index="4" dlg:left="156" dlg:top="6" dlg:width="24" dlg:height="8" dlg:value="Receptor " dlg:align="right"/>
  <dlg:button dlg:id="cmdSalir" dlg:tab-index="7" dlg:left="307" dlg:top="233" dlg:width="60" dlg:height="12" dlg:value="Salir" dlg:image-position="left-center" dlg:image-align="left" dlg:grab-focus="false"/>
  <dlg:textfield dlg:id="txtReceptor" dlg:tab-index="5" dlg:left="182" dlg:top="4" dlg:width="120" dlg:height="12" dlg:help-text="Buscar Receptor" dlg:value="Todos"/>
  <dlg:fixedline dlg:id="FixedLine1" dlg:tab-index="8" dlg:left="3" dlg:top="18" dlg:width="365" dlg:height="6"/>
  <dlg:textfield dlg:id="txtCfd" dlg:tab-index="9" dlg:left="316" dlg:top="4" dlg:width="40" dlg:height="12" dlg:help-text="Buscar CFD"/>
  <dlg:button dlg:id="cmdFiltrar1" dlg:tab-index="10" dlg:left="302" dlg:top="4" dlg:width="12" dlg:height="12" dlg:tag="1" dlg:help-text="Filtrar" dlg:image-position="left-center" dlg:image-align="left" dlg:grab-focus="false"/>
